# --- Server ---
PORT=3000
FRONTEND_URL=http://localhost:5173

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=classboard

# --- Admin auth (JWT) ---
# Long random string used to sign login tokens — e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Used only by `npm run seed:admin` to create the first admin user.
# Run it once, then feel free to remove these two lines.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-password
