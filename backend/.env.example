# --- Server ---
PORT=3000
FRONTEND_URL=http://localhost:5173

# --- PostgreSQL ---
# Option A: a single connection string (used by Railway and most managed
# hosts). If set, this takes priority over the DB_* fields below.
# DATABASE_URL=postgresql://user:password@host:port/database
# Set to "true" when connecting to a host over the public internet (e.g.
# Railway's public proxy from your local machine) — not needed for
# same-project internal connections.
# DB_SSL=true

# Option B: discrete fields (used when DATABASE_URL is not set).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=classboard

# --- Admin auth (JWT) ---
# Long random string used to sign login tokens — e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Used only by `npm run seed:admin` to create the first admin user.
# Run it once, then feel free to remove these two lines.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-password
